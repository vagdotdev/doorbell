# Copy to `.env` (gitignored). `swift run` and `scripts/bundle.sh` read this.
#
# Leave DOORBELL_BACKEND unset for the mock hallway (fake friends, no network).

# --- Friends on Convex (this is the path) -----------------------------------------
DOORBELL_BACKEND=convex
# From `.env.local` after `npm run dev` (or paste the cloud URL after `npx convex deploy`).
CONVEX_URL=http://127.0.0.1:3210

# Optional. Friends join with just a name + @handle. Under the hood every account is
# `{handle}@doorbell.local` + this shared secret. Same handle on another Mac works.
# DOORBELL_JOIN_SECRET=doorbell

# --- Two people on one Mac --------------------------------------------------------
# open -n build/Doorbell.app --env DOORBELL_PROFILE=bob

# --- Old Supabase stack (legacy) --------------------------------------------------
# DOORBELL_BACKEND=supabase
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
