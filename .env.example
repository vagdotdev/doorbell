# Copy to .env (gitignored). Development only — `swift run` reads it from the working
# directory and scripts/bundle.sh copies it into build/Doorbell.app.
#
# Leave DOORBELL_BACKEND unset for the mock hallway (no network, fake friends).

# --- Local stack (supabase start + livekit-server --dev) ---------------------------
DOORBELL_BACKEND=supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=            # supabase status -o env → ANON_KEY

# --- Cloud -----------------------------------------------------------------------
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=
# LiveKit Cloud → Settings → Keys. These live on the server, not in the app:
#   supabase secrets set LIVEKIT_URL=... LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...

# --- Two accounts on one Mac -----------------------------------------------------
# DOORBELL_PROFILE=b   separate session + settings; pass per launch, not here
