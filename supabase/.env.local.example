# Copy to supabase/.env.local (gitignored). Secrets for the door-token function when
# it runs locally:  supabase functions serve door-token --env-file supabase/.env.local
#
# The function runs inside Docker; livekit-server --dev runs on the host. The first
# URL is how the function reaches it, the second is what it hands to the app.
LIVEKIT_URL=http://host.docker.internal:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
