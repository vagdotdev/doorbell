# Copy to `.env.secrets` (gitignored). Server-side secrets for Convex + the friend-group join phrase.
# Never commit `.env.secrets`. LiveKit secrets live here and are pushed to Convex by `scripts/setup-local.sh`.

# Friend-group join password ({handle}@doorbell.local). Share privately with friends only.
DOORBELL_JOIN_SECRET=change-me-to-a-long-random-phrase

# LiveKit Cloud — from https://cloud.livekit.io/ → your project → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
